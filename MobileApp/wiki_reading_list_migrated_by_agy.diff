+
+data class AdminEditStoryUiState(
+    val storyId: String = "",
+    val originalStory: AppStory? = null,
+    val name: String = "",
+    val oneLiner: String = "",
+    val techStack: String = "",
+    val originStory: String = "",
+    val growthPlaybook: String = "",
+    val category: String = "",
+    val publisher: String = "",
+    val revenue: String = "",
+    val downloads: String = "",
